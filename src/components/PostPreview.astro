---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = { post: CollectionEntry<'blog'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { post, class: className, headingLevel = 'h2' } = Astro.props;
const { title, publishDate, updatedDate, excerpt, seo } = post.data;
const heroImage = seo?.image;
const TitleTag = headingLevel;
---

<a
  class:list={[
    'flex flex-col sm:flex-row group',
    'border border-main border-opacity-20 border-l-4 border-l-accent',
    'bg-muted',
    'transition-colors duration-200',
    'hover:bg-accent/10',
    'overflow-hidden',
    className
  ]}
  href={`/blog/${post.id}/`}
>
  {heroImage && (
    <div class="w-full h-48 sm:w-56 sm:h-56 sm:shrink-0 dark:bg-white">
      <img
        src={heroImage.src}
        alt={heroImage.alt || ''}
        class="w-full h-full object-cover"
      />
    </div>
  )}
  <div class="flex justify-between items-start gap-6 p-6 grow min-w-0">
    <div class="grow min-w-0">
      <TitleTag class="text-3xl leading-tight font-display font-semibold text-accent group-hover:underline group-hover:underline-offset-4 sm:text-4xl">
        {title}
      </TitleTag>
      <div class="mt-3 text-lg font-mono opacity-60">
        <FormattedDate date={publishDate} />
        {
          updatedDate && (
            <>
              {' '}
              <span>
                (Updated on <FormattedDate date={updatedDate} />)
              </span>
            </>
          )
        }
      </div>
      {excerpt && <p class="mt-3 text-lg opacity-80 line-clamp-2">{excerpt}</p>}
    </div>
    <div class="font-sans text-lg opacity-60 transition-all group-hover:opacity-100 group-hover:translate-x-1 inline-flex gap-1 items-center shrink-0">
      Read <ArrowRight class="fill-current w-4 h-4" aria-hidden="true" />
    </div>
  </div>
</a>
