---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../icons/ArrowRight.astro';

type Props = {
  project: CollectionEntry<'projects'>;
  class?: string;
  headingLevel?: 'h2' | 'h3';
};

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, timeperiod, company, description } = project.data;
const TitleTag = headingLevel;
---

<a
  class:list={[
    'flex justify-between items-start gap-6 group',
    'p-6 border border-main border-opacity-20 border-l-4 border-l-accent',
    'bg-muted',
    'transition-colors duration-200',
    'hover:bg-accent/10',
    className
  ]}
  href={`/projects/${project.id}/`}
>
  <div class="grow">
    <TitleTag
      class="text-3xl leading-tight font-display font-semibold text-accent group-hover:underline group-hover:underline-offset-4 sm:text-4xl"
    >
      {title}
    </TitleTag>
    {(company || timeperiod) && (
      <div class="mt-3 text-xl font-mono leading-relaxed">
        {company && <span class="font-medium">{company}</span>}
        {company && timeperiod && <span class="opacity-80"> | </span>}
        {timeperiod && <span class="opacity-80">{timeperiod}</span>}
      </div>
    )}
    {description && (
      <p class="mt-3 text-lg opacity-80 line-clamp-2">{description}</p>
    )}
  </div>
  <div
    class="font-sans text-lg opacity-60 transition-all group-hover:opacity-100 group-hover:translate-x-1 inline-flex gap-1 items-center shrink-0"
  >
    View <ArrowRight class="fill-current w-4 h-4" aria-hidden="true" />
  </div>
</a>
