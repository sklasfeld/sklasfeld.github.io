---
import ArrowRight from '../icons/ArrowRight.astro';
import FormattedDate from './FormattedDate.astro';

type Props = {
  series: {
    name: string;
    slug: string;
    postCount: number;
    latestDate: Date;
    firstDate: Date;
    image?: { src: string; alt?: string };
  };
  class?: string;
  headingLevel?: 'h2' | 'h3';
};

const { series, class: className, headingLevel = 'h2' } = Astro.props;
const TitleTag = headingLevel;
---

<a
  class:list={[
    'flex flex-col sm:flex-row group',
    'border border-main border-opacity-20 border-l-4 border-l-accent-secondary',
    'bg-muted',
    'transition-colors duration-200',
    'hover:bg-accent-secondary/10',
    'overflow-hidden',
    className
  ]}
  href={`/blog/${series.slug}/`}
>
  {series.image && (
    <div class="w-full h-48 sm:w-56 sm:h-56 sm:shrink-0 dark:bg-white">
      <img
        src={series.image.src}
        alt={series.image.alt || ''}
        class="w-full h-full object-cover"
      />
    </div>
  )}
  <div class="flex justify-between items-start gap-6 p-6 grow min-w-0">
    <div class="grow min-w-0">
      <div class="inline-block px-2 py-0.5 mb-2 text-sm font-mono font-semibold uppercase tracking-wider bg-accent-secondary/10 text-accent-secondary">
        {series.postCount}-part series
      </div>
      <TitleTag class="text-3xl leading-tight font-display font-semibold text-accent-secondary group-hover:underline group-hover:underline-offset-4 sm:text-4xl">
        {series.name}
      </TitleTag>
      <div class="mt-3 text-lg font-mono opacity-60">
        <FormattedDate date={series.firstDate} /> &ndash; <FormattedDate date={series.latestDate} />
      </div>
    </div>
    <div class="font-sans text-lg opacity-60 transition-all group-hover:opacity-100 group-hover:translate-x-1 inline-flex gap-1 items-center shrink-0">
      View <ArrowRight class="fill-current w-4 h-4" aria-hidden="true" />
    </div>
  </div>
</a>
